{
  "comment": "The language's closed vocabularies. editors/vscode/test/test_vocabulary.py checks them against libaxitl. Pens map to the preview colour axitime renders them in.",
  "entities": ["person", "event", "span", "group"],
  "bandedEntities": ["person", "span", "group"],
  "backgrounds": ["graph"],
  "corners": ["title", "credits"],
  "notes": ["note"],
  "pens": {
    "red": "#c62828", "orange": "#ef6c00", "yellow": "#f9a825", "green": "#2e7d32", "blue": "#1565c0",
    "indigo": "#3949ab", "violet": "#6a1b9a", "black": "#212121", "grey": "#757575",
    "6B-pencil": "#55555d", "5B-pencil": "#5b5b63", "4B-pencil": "#616169", "3B-pencil": "#67676f",
    "2B-pencil": "#6d6d75", "B-pencil": "#73737b", "HB-pencil": "#797981", "F-pencil": "#7f7f87",
    "H-pencil": "#85858d", "2H-pencil": "#8b8b93", "3H-pencil": "#919199", "4H-pencil": "#97979f",
    "5H-pencil": "#9d9da5", "6H-pencil": "#a3a3ab",
    "fountain-red": "#c62828", "fountain-orange": "#ef6c00", "fountain-yellow": "#f9a825",
    "fountain-green": "#2e7d32", "fountain-blue": "#1565c0", "fountain-indigo": "#3949ab",
    "fountain-violet": "#6a1b9a", "fountain-black": "#212121", "fountain-grey": "#757575"
  },
  "defaultPen": "black",
  "defaultGraphPen": "HB-pencil",
  "fonts": [
    "HersheySans1", "HersheySansMed", "HersheySerifMed", "HersheySerifMedItalic", "HersheySerifBold",
    "HersheySerifBoldItalic", "HersheyScript1", "HersheyScriptMed", "HersheyGothEnglish", "EMSAllure",
    "EMSElfin", "EMSFelix", "EMSNixish", "EMSNixishItalic", "EMSOsmotron", "EMSReadability",
    "EMSReadabilityItalic", "EMSTech"
  ],
  "defaultFont": "HersheySans1",
  "timelineParameters": [
    "start", "end", "length", "scale", "width", "baseline",
    "lane_height", "above_lane_height", "below_lane_height",
    "baseline_offset", "above_baseline_offset", "below_baseline_offset",
    "ticks", "tick_label_every", "open_end_style", "font", "font_size", "time_label"
  ],
  "entityParameters": ["fill", "fill_pen", "font", "font_size", "time_label"],
  "includeParameters": ["priority", "side"],
  "illustrationParameters": ["height", "fill", "pens"],
  "titleIllustrationParameters": ["height", "at", "fill", "pens"],
  "creditsIllustrationParameters": ["at", "fill", "pens"],
  "noteIllustrationParameters": ["at", "fill", "pens"],
  "graphParameters": [
    "data", "first_row", "last_row", "header", "separator", "time_column", "value_column", "time_format", "missing",
    "origin", "y_scale", "height", "range", "line", "fill", "fill_pen", "fill_depth", "shadow", "value_scale",
    "value_marks", "unit", "font", "font_size"
  ],
  "titleParameters": ["font", "font_size", "subtitle", "subtitle_font", "subtitle_font_size", "align", "margin", "gap"],
  "creditsParameters": ["font", "font_size", "heading_font", "heading_font_size", "max_height", "align", "margin", "gap"],
  "noteParameters": [
    "anchor", "edge", "width", "align", "font", "font_size", "heading_font", "heading_font_size", "margin",
    "clearance", "gap"
  ],
  "values": {
    "fill": ["none", "solid", "diagonal", "crosshatch", "wave", "dots"],
    "time_label": ["none", "date", "year", "month", "day", "hour", "min", "sec"],
    "baseline": ["high", "middle", "low"],
    "open_end_style": ["sawtooth", "sine"],
    "side": ["above", "below"],
    "ticks": ["off"],
    "end": ["now"],
    "y_scale": ["linear", "log"],
    "line": ["straight", "smooth", "step"],
    "header": ["yes", "no"],
    "separator": ["comma", "semicolon", "tab"],
    "origin": ["first"],
    "value_scale": ["off", "start"],
    "value_marks": ["auto"],
    "time_format": ["decimal_year"],
    "at": ["left", "right"],
    "align": ["left", "right"],
    "pens": ["auto"],
    "anchor": ["start", "middle", "end"],
    "edge": ["top", "bottom"]
  },
  "scaleUnits": ["year", "day", "hour", "minute", "second"]
}
